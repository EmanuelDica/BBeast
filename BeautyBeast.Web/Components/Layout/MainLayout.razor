@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject TokenStore Tokens
@inject NavigationManager Nav

@if (!_hydrated)
{
    <div class="auth-shell"><div class="muted">Loading…</div></div>
}
else if (!Tokens.IsAuthenticated)
{
    <div class="auth-shell"><div class="muted">Redirecting…</div></div>
}
else
{
    <div class="app-shell">
        <header class="topbar">
            <div class="topbar-left">
                <button class="btn-icon" @onclick="ToggleSidebar" title="Toggle sidebar">&#9776;</button>
            </div>
            <a class="topbar-brand" href="/feed">
                <span class="auth-logo" style="width:30px;height:30px;font-size:1.05rem;border-radius:9px">B</span>
                BeautyBeast
            </a>
            <div class="topbar-right">
                <div class="topbar-search">
                    <input type="search"
                           @bind="_searchQuery"
                           @bind:event="oninput"
                           @onkeydown="OnSearchKeyDown"
                           placeholder="Search…" />
                </div>
                <NotificationBell />
            </div>
        </header>
        <div class="app-body">
            <aside class="sidebar @(_sidebarOpen ? "" : "collapsed")">
                <NavMenu />
            </aside>
            <main class="main-pane">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private bool _hydrated;
    private bool _sidebarOpen = true;
    private string _searchQuery = "";

    protected override void OnInitialized()
    {
        Tokens.Changed += OnTokensChanged;
        Tokens.ForceLogout += OnForceLogout;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.TryRestoreSessionAsync();
            _hydrated = true;
            await EnsureAuthAsync();
            StateHasChanged();
        }
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim();
            _searchQuery = "";
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(q)}");
        }
    }

    private void OnTokensChanged()
    {
        // If the user just lost auth (logout or 401) redirect with a full reload.
        // forceLoad: true is the only reliable way to navigate from within a
        // synchronous event callback fired mid-async-operation in Blazor Server —
        // soft navigation gets queued behind the current render cycle and silently loses.
        if (_hydrated && !Tokens.IsAuthenticated)
        {
            Nav.NavigateTo("/signin", forceLoad: true);
            return;
        }
        StateHasChanged();
    }

    private async void OnForceLogout()
    {
        await Auth.LogoutAsync();
        // LogoutAsync → TokenStore.Clear → Changed → OnTokensChanged handles the redirect.
    }

    private Task EnsureAuthAsync()
    {
        if (!_hydrated) return Task.CompletedTask;
        if (Tokens.IsAuthenticated) return Task.CompletedTask;
        // First-render path: user arrived on a protected page without a session.
        // Soft navigation is fine here because we're inside OnAfterRenderAsync,
        // not inside a Changed event callback.
        var returnUrl = new Uri(Nav.Uri).PathAndQuery;
        var target = "/signin";
        if (!string.IsNullOrEmpty(returnUrl) && returnUrl != "/" && returnUrl != "/signin" && returnUrl != "/signup")
            target += $"?return={Uri.EscapeDataString(returnUrl)}";
        Nav.NavigateTo(target, forceLoad: false, replace: true);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Tokens.Changed -= OnTokensChanged;
        Tokens.ForceLogout -= OnForceLogout;
    }
}
