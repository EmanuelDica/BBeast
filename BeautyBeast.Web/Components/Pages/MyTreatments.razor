@page "/me/treatments"
@inject TreatmentService Treatments
@inject TokenStore Tokens

<div class="page-header">
    <h1>My treatments</h1>
    <a class="btn" href="/me/treatments/new">Add treatment</a>
</div>

@if (!Tokens.IsAuthenticated || Tokens.User?.Role != UserRole.Artist)
{
    <div class="empty">Only artists can manage treatments. <a href="/signin">Sign in</a>.</div>
}
else if (_list is null)
{
    <p class="muted">Loading…</p>
}
else if (_list.Count == 0)
{
    <div class="empty">No treatments yet. <a href="/me/treatments/new">Add one</a>.</div>
}
else
{
    <div class="list-grid">
        @foreach (var t in _list)
        {
            <div class="card">
                @if (!string.IsNullOrWhiteSpace(t.ImageUrl)) { <img class="media-thumb" src="@t.ImageUrl" alt="@t.Name" /> }
                <h3>@t.Name</h3>
                @if (!string.IsNullOrWhiteSpace(t.Category)) { <span class="tag">@t.Category</span> }
                <span class="tag">@t.DurationMinutes min</span>
                <span class="tag brand">@t.Price.ToString("C")</span>
                @if (!t.IsActive) { <span class="tag" style="background:#ffe7d6;color:#a04400">Hidden</span> }
                <p class="muted">@t.Description</p>
                <div class="right">
                    <a class="btn secondary tiny" href="@($"/treatments/{t.Id}")">View</a>
                    <a class="btn tiny" href="@($"/me/treatments/{t.Id}/edit")">Edit</a>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Treatment>? _list;

    protected override async Task OnInitializedAsync()
    {
        if (!Tokens.IsAuthenticated || Tokens.User?.Role != UserRole.Artist) return;
        try { _list = await Treatments.ListAsync(artistId: Tokens.User!.Id) ?? new(); }
        catch { _list = new(); }
    }
}
