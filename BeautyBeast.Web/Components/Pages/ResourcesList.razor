@page "/resources"
@inject ResourceService Resources

<div class="page-header">
    <h1>Educational library</h1>
    <input type="search" placeholder="Search resources…" @bind="_q" @onkeyup="OnKey" style="max-width:320px" />
</div>

<p class="muted">Evidence-based articles, videos, and documents shared by professionals on the platform.</p>

@if (_list is null) { <p class="muted">Loading…</p> }
else if (_list.Count == 0) { <div class="empty">No resources found.</div> }
else
{
    <div class="list-grid">
        @foreach (var r in _list)
        {
            <div class="card">
                <h3><a href="@($"/resources/{r.Id}")">@r.Title</a></h3>
                @if (!string.IsNullOrWhiteSpace(r.Category)) { <span class="tag">@r.Category</span> }
                <span class="tag brand">@r.Kind</span>
                <p class="muted" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">@r.Body</p>
                <div class="muted" style="font-size:.82em">By <a href="/artists/@r.AuthorUsername">@r.AuthorDisplayName</a> · @r.CreatedAt.ToLocalTime().ToString("d")</div>
            </div>
        }
    </div>
}

@code {
    private string _q = "";
    private List<Resource>? _list;

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ReloadAsync(); }

    private async Task ReloadAsync()
    {
        try { _list = await Resources.ListAsync(string.IsNullOrWhiteSpace(_q) ? null : _q) ?? new(); }
        catch { _list = new(); }
    }
}
