# Copy this file to .env and fill in real values before running docker compose.
# .env is git-ignored — never commit real secrets.

# PostgreSQL
POSTGRES_DB=beautybeast
POSTGRES_USER=bbuser
POSTGRES_PASSWORD=changeme

# API
JWT_KEY=replace-with-a-long-random-secret-minimum-32-chars
JWT_ISSUER=BeautyBeast.Api
JWT_AUDIENCE=BeautyBeast.Web
